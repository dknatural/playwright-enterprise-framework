{
  "name": "playwright-enterprise-framework",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "cross-env HEADLESS=false playwright test --project=chromium",
    "test:ui": "playwright test --project=chromium --headed",
    "test:headed": "cross-env HEADLESS=false playwright test --project=chromium --workers=1",
    "test:debug": "playwright test --debug --workers=1",
    "test:hybrid": "playwright test tests/hybrid",
    "test:staging": "cross-env TEST_ENV=staging playwright test",
    "allure:failure-demo": "cross-env ALLURE_FAILURE_DEMO=true HEADLESS=false playwright test tests/orangehrm/login.spec.ts tests/orangehrm/allure-failure-demo.spec.ts --project=chromium --workers=1",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "allure:clean": "node -e \"require('node:fs').rmSync('allure-results', { recursive: true, force: true })\"",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^2.15.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "pg": "^8.13.0"
  }
}
