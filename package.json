{
  "name": "playwright-enterprise-framework",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium --headed",
    "test:headed": "playwright test --headed --workers=1",
    "test:debug": "playwright test --debug --workers=1",
    "test:hybrid": "playwright test tests/hybrid",
    "test:staging": "cross-env TEST_ENV=staging playwright test",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {"pg": "^8.13.0"}
}
